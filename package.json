{
  "name": "slack-lite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NODE_OPTIONS=--no-network-family-autoselection --dns-result-order=ipv4first&& next dev --webpack",
    "dev:turbo": "set NODE_OPTIONS=--no-network-family-autoselection --dns-result-order=ipv4first&& next dev",
    "dev:stop": "node scripts/stop-next-dev.mjs",
    "dev:restart": "npm run dev:stop && npm run dev",
    "dev:backend": "convex dev",
    "convex:dev": "convex dev",
    "convex:dashboard": "convex dashboard",
    "build": "set NODE_OPTIONS=--no-network-family-autoselection --dns-result-order=ipv4first&& next build",
    "start": "set NODE_OPTIONS=--no-network-family-autoselection --dns-result-order=ipv4first&& next start",
    "lint": "eslint"
  },
  "engines": {
    "node": ">=20.9 <23"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@convex-dev/auth": "^0.0.91",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.33.1",
    "jotai": "^2.19.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-resizable-panels": "^4.11.1",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
